# .env.example
# 请将此文件复制重命名为 .env，并填入你真实的配置信息

# ==========================================
# LLM 模型配置（DashScope / OpenAI 兼容接口）
# ==========================================
DASHSCOPE_API_KEY="sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
MODEL_NAME="qwen-plus"

# 本地 embedding（不消耗 DashScope embedding 额度）
EMBEDDING_BACKEND="fastembed"
EMBEDDING_MODEL="sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2"

# ==========================================
# 向量数据库配置（Milvus）
# ==========================================
MILVUS_URI="http://localhost:19530"
MILVUS_TOKEN=""
RAG_HYBRID_ENABLED="true"
AUTO_INGEST_ENABLED="false"
AUTONOMOUS_TOOL_SELECTION_ENABLED="true"

# ==========================================
# 消息队列配置（Celery + Redis）
# ==========================================
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/1"

# Demo 下载目录（跨平台路径）
DEMO_DOWNLOAD_DIR="data/demos"
GRAPH_DB_PATH="data/graph/cs2_graph.sqlite"
